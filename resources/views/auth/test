<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Slider Élégant - Basma Collection</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
    
        .slider-container {
            position: relative;
            width: 100%;
            height: 100vh;
         
            overflow: hidden;
            background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 50%);
        }

        .slide {
            position: absolute;
            width: 100%;
            height: 100%;
            opacity: 0;
            transition: opacity 1.5s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .slide.active {
            opacity: 1;
            z-index: 2;
        }

        .slide-background {
            position: absolute;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        .slide-background::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(195, 133, 149, 0.3) 0%, rgba(26, 26, 26, 0.7) 100%);
            z-index: 1;
        }

        .slide-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            transform: scale(1.1);
            animation: kenburns 20s ease-in-out infinite alternate;
        }

        @keyframes kenburns {
            0% {
                transform: scale(1.1) translate(0, 0);
            }
            100% {
                transform: scale(1.2) translate(-20px, -10px);
            }
        }

        .slide-content {
            position: relative;
            z-index: 3;
            text-align: center;
            color: white;
            max-width: 900px;
            width: 90%;
            padding: 0 30px;
            animation: slideContentIn 1.2s cubic-bezier(0.4, 0, 0.2, 1) forwards;
            opacity: 0;
        }

        .active .slide-content {
            animation: slideContentIn 1.2s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }

        @keyframes slideContentIn {
            0% {
                opacity: 0;
                transform: translateY(60px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .slide-badge {
            display: inline-block;
            font-family: 'Montserrat', sans-serif;
            font-size: clamp(0.65rem, 2vw, 0.75rem);
            font-weight: 500;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--accent-gold);
            padding: 10px 20px;
            border: 1px solid var(--accent-gold);
            margin-bottom: 20px;
            animation: fadeInScale 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.3s backwards;
            position: relative;
            overflow: hidden;
        }

        .slide-badge::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: var(--accent-gold);
            transition: left 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: -1;
        }

        .slide-badge:hover::before {
            left: 0;
        }

        .slide-badge:hover {
            color: var(--dark);
        }

        @keyframes fadeInScale {
            0% {
                opacity: 0;
                transform: scale(0.8);
            }
            100% {
                opacity: 1;
                transform: scale(1);
            }
        }

        .slide-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(2.5rem, 10vw, 6rem);
            font-weight: 300;
            line-height: 1.1;
            margin-bottom: 25px;
            animation: fadeInUp 1s cubic-bezier(0.4, 0, 0.2, 1) 0.5s backwards;
            letter-spacing: 1px;
        }

        @keyframes fadeInUp {
            0% {
                opacity: 0;
                transform: translateY(40px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .slide-description {
            font-size: clamp(0.9rem, 2.5vw, 1.25rem);
            font-weight: 300;
            line-height: 1.6;
            margin-bottom: 30px;
            opacity: 0.95;
            animation: fadeInUp 1s cubic-bezier(0.4, 0, 0.2, 1) 0.7s backwards;
            letter-spacing: 0.3px;
        }

        .slide-cta {
            display: inline-block;
            font-family: 'Montserrat', sans-serif;
            font-size: clamp(0.75rem, 2vw, 1rem);
            font-weight: 500;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: white;
            background: #c38595;
            padding: 15px 40px;
            text-decoration: none;
            position: relative;
            overflow: hidden;
            animation: fadeInUp 1s cubic-bezier(0.4, 0, 0.2, 1) 0.9s backwards;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: 2px solid var(--primary-color);
        }

        .slide-cta::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: white;
            transition: left 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: -1;
        }

        .slide-cta:hover::before {
            left: 0;
        }

        .slide-cta:hover {
            color: var(--primary-color);
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(195, 133, 149, 0.4);
        }

        /* Navigation Dots */
        .slider-dots {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 15px;
            z-index: 10;
        }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            border: 2px solid transparent;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
        }

        .dot.active {
            background: var(--primary-color);
            border-color: white;
            transform: scale(1.3);
        }

        .dot:hover {
            background: rgba(255, 255, 255, 0.6);
            transform: scale(1.2);
        }

        /* Navigation Arrows */
        .slider-nav {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            z-index: 10;
            width: 50px;
            height: 50px;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .slider-nav:hover {
            background: rgba(195, 133, 149, 0.9);
            transform: translateY(-50%) scale(1.1);
        }

        .slider-nav.prev {
            left: 20px;
        }

        .slider-nav.next {
            right: 20px;
        }

        .slider-nav svg {
            width: 20px;
            height: 20px;
            fill: white;
        }

        /* Decorative Elements */
        .decorative-line {
            position: absolute;
            width: 1px;
            height: 70px;
            background: linear-gradient(to bottom, transparent, var(--accent-gold), transparent);
            top: -90px;
            left: 50%;
            transform: translateX(-50%);
            animation: lineFloat 3s ease-in-out infinite;
        }

        @keyframes lineFloat {
            0%, 100% {
                transform: translateX(-50%) translateY(0);
            }
            50% {
                transform: translateX(-50%) translateY(15px);
            }
        }

        /* Responsive Design - Tablet */
        @media (max-width: 1024px) and (min-width: 769px) {
            .slide-title {
                font-size: clamp(3rem, 8vw, 5rem);
            }
        }

        /* Responsive Design - Mobile */
        @media (max-width: 768px) {
            .slider-container {
                height: 55vh;
                width: 100%;
            }

            .slide-content {
                padding: 0 20px;
                width: 92%;
            }

            .slide-badge {
                padding: 8px 18px;
                letter-spacing: 1.5px;
                margin-bottom: 15px;
                font-size: 0.65rem;
            }

            .slide-title {
                font-size: clamp(2rem, 12vw, 3.5rem);
                margin-bottom: 18px;
                line-height: 1.15;
            }

            .slide-description {
                font-size: clamp(0.85rem, 3vw, 1.1rem);
                margin-bottom: 25px;
                line-height: 1.5;
            }

            .slide-cta {
                padding: 13px 32px;
                letter-spacing: 1.5px;
                font-size: 0.8rem;
            }

            .slider-nav {
                width: 45px;
                height: 45px;
            }

            .slider-nav.prev {
                left: 15px;
            }

            .slider-nav.next {
                right: 15px;
            }

            .slider-nav svg {
                width: 18px;
                height: 18px;
            }

            .slider-dots {
                bottom: 25px;
                gap: 12px;
            }

            .dot {
                width: 9px;
                height: 9px;
            }

            .decorative-line {
                height: 50px;
                top: -70px;
            }

            .slide-background::before {
                background: linear-gradient(135deg, rgba(195, 133, 149, 0.35) 0%, rgba(26, 26, 26, 0.75) 100%);
            }
        }

        /* Small Mobile */
        @media (max-width: 480px) {
            .slide-content {
                padding: 0 18px;
            }

            .slide-title {
                letter-spacing: 0.5px;
                font-size: clamp(1.8rem, 11vw, 3rem);
            }

            .slide-badge {
                font-size: 0.6rem;
                padding: 7px 16px;
            }

            .slide-cta {
                padding: 12px 28px;
            }

            .slider-dots {
                bottom: 20px;
            }

            .slider-nav {
                width: 40px;
                height: 40px;
            }

            .slider-nav.prev {
                left: 10px;
            }

            .slider-nav.next {
                right: 10px;
            }
        }

        /* Very Small Mobile */
        @media (max-width: 375px) {
            .slide-title {
                font-size: clamp(1.6rem, 10vw, 2.5rem);
            }

            .slide-badge {
                font-size: 0.55rem;
                padding: 6px 14px;
            }

            .slide-cta {
                padding: 11px 24px;
                font-size: 0.75rem;
            }
        }

        /* Landscape mode on mobile */
        @media (max-height: 600px) and (orientation: landscape) {
            .slider-container {
                height: 100vh;
            }

            .slide-title {
                font-size: clamp(1.5rem, 7vw, 2.5rem);
                margin-bottom: 12px;
            }

            .slide-description {
                font-size: clamp(0.75rem, 2vw, 0.95rem);
                margin-bottom: 15px;
            }

            .slide-badge {
                margin-bottom: 10px;
                padding: 6px 14px;
                font-size: 0.6rem;
            }

            .slide-cta {
                padding: 10px 24px;
                font-size: 0.75rem;
            }

            .decorative-line {
                display: none;
            }

            .slider-dots {
                bottom: 15px;
            }
        }

        /* iPhone SE and similar small screens */
        @media (max-width: 375px) and (max-height: 667px) {
            .slide-title {
                font-size: 1.8rem;
                margin-bottom: 12px;
            }

            .slide-description {
                font-size: 0.85rem;
                margin-bottom: 18px;
            }
        }
    </style>
</head>
<body>
    <div class="slider-container">
        <!-- Slide 1 -->
        <div class="slide active">
            <div class="slide-background">
                <img src="http://www.bassmacollection.com/wp-content/uploads/2022/07/IMG_5541-_1_-scaled.jpg" 
                     alt="Collection Basma" 
                     class="slide-image">
            </div>
            <div class="slide-content">
                <div class="decorative-line"></div>
                <div class="slide-badge">Collection Exclusive</div>
                <h1 class="slide-title">Élégance<br>Raffinée</h1>
                <a href="#" class="slide-cta">Acheter Maintenant</a>
            </div>
        </div>

       

    </div>

    <script>
        let currentSlide = 0;
        const slides = document.querySelectorAll('.slide');
        const dots = document.querySelectorAll('.dot');
        let autoSlideInterval;

        function showSlide(index) {
            slides.forEach(slide => slide.classList.remove('active'));
            dots.forEach(dot => dot.classList.remove('active'));

            if (index >= slides.length) {
                currentSlide = 0;
            } else if (index < 0) {
                currentSlide = slides.length - 1;
            } else {
                currentSlide = index;
            }

            slides[currentSlide].classList.add('active');
            dots[currentSlide].classList.add('active');
        }

        function changeSlide(direction) {
            showSlide(currentSlide + direction);
            resetAutoSlide();
        }

        function goToSlide(index) {
            showSlide(index);
            resetAutoSlide();
        }

        function autoSlide() {
            changeSlide(1);
        }

        function resetAutoSlide() {
            clearInterval(autoSlideInterval);
            autoSlideInterval = setInterval(autoSlide, 6000);
        }

        autoSlideInterval = setInterval(autoSlide, 6000);

        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft') {
                changeSlide(-1);
            } else if (e.key === 'ArrowRight') {
                changeSlide(1);
            }
        });

        // Touch support
        let touchStartX = 0;
        let touchEndX = 0;

        document.querySelector('.slider-container').addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });

        document.querySelector('.slider-container').addEventListener('touchend', (e) => {
            touchEndX = e.changedTouches[0].screenX;
            handleSwipe();
        }, { passive: true });

        function handleSwipe() {
            if (touchEndX < touchStartX - 50) {
                changeSlide(1);
            }
            if (touchEndX > touchStartX + 50) {
                changeSlide(-1);
            }
        }

        // Prevent double-tap zoom on iOS
        let lastTouchEnd = 0;
        document.addEventListener('touchend', function (event) {
            const now = (new Date()).getTime();
            if (now - lastTouchEnd <= 300) {
                event.preventDefault();
            }
            lastTouchEnd = now;
        }, false);

        // Handle viewport resize
        window.addEventListener('resize', () => {
            // Force recalculation on orientation change
            document.body.style.height = '100vh';
            document.body.style.height = '100dvh';
        });
    </script>
</body>
</html>